{
  "manifest_version": 2,

  "name": "TubeGuard Blocker",
  "short_name": "ytblock",
  "version": "1.0.0",
  "description": "Blocage des publicites YouTube : filtrage reseau facon Adblock Plus + filtres cosmetiques + saut des coupures dans le lecteur.",

  "browser_specific_settings": {
    "gecko": {
      "id": "ytblock@tubeguard.local",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "lib/filters.js",
      "background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtu.be/*"
      ],
      "js": ["content/ads.js"],
      "css": ["content/ads.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
