<?xml version="1.0" encoding="utf-8"?>
<!--
    Aucune sauvegarde automatique : le profil Gecko contient les cookies de
    session Google. On ne veut ni qu'ils partent sur Google Drive, ni qu'ils
    soient transferes vers un autre appareil.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
