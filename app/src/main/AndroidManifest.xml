<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau : indispensable pour GeckoView. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lecture audio quand l'écran est éteint. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notification de lecture (obligatoire pour un service foreground sur Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Le Picture-in-Picture natif nécessite que l'appareil le supporte,
         mais l'app doit rester installable sur ceux qui ne l'ont pas. -->
    <uses-feature
        android:name="android.software.picture_in_picture"
        android:required="false" />

    <application
        android:name=".TubeGuardApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.TubeGuard"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:hardwareAccelerated="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|navigation|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TubeGuard">

            <!-- Lanceur d'applications -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Interception des liens YouTube.

                android:autoVerify="false" : la vérification App Links (Digital
                Asset Links) exige de pouvoir déposer un fichier
                /.well-known/assetlinks.json sur youtube.com, ce qui est
                évidemment impossible. Conséquence sur Android 12+ : le système
                n'ouvrira PAS l'app automatiquement tant que tu n'as pas activé
                manuellement l'option "Ouvrir les liens compatibles" dans
                Paramètres > Applications > TubeGuard > Liens de l'application.
                (Procédure détaillée dans le README.)
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />

                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:host="youtu.be" />
                <data android:host="www.youtu.be" />
                <data android:host="youtube-nocookie.com" />
                <data android:host="www.youtube-nocookie.com" />
            </intent-filter>

            <!-- Schémas propriétaires utilisés par certaines apps pour ouvrir YouTube. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vnd.youtube" />
                <data android:scheme="vnd.youtube.launch" />
            </intent-filter>

            <!-- Repli : "Partager vers TubeGuard" depuis n'importe quelle app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Service foreground : garde le process vivant + notification média. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Boutons média du casque / Bluetooth. -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
